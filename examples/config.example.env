# Remote Workstation Anywhere - example configuration
#
# Copy to ~/.config/remote-workstation-anywhere/config.env and edit.
#   mkdir -p ~/.config/remote-workstation-anywhere
#   cp examples/config.example.env ~/.config/remote-workstation-anywhere/config.env
#   chmod 600 ~/.config/remote-workstation-anywhere/config.env
#
# Override the location with:  RWA_CONFIG=/path/to/file
# Environment variables take precedence over values in this file.
#
# Format: KEY="value" - one per line. This file is parsed, NOT executed:
# no shell expansion, no command substitution, no inline comments.
#
# NEVER put a password in this file. Passwords come from the OS credential store.
# All values below are documentation placeholders. Replace them with your own.

# Workstation (the powerful machine). IP address or resolvable hostname.
# Give it a DHCP reservation so this does not change.
WORKSTATION_IP="192.168.1.50"

# Workstation Ethernet MAC address, used for Wake-on-LAN.
WORKSTATION_MAC="00:11:22:33:44:55"

# RDP port on the workstation.
RDP_PORT="3389"

# RDP username configured on the workstation.
RDP_USERNAME="youruser"

# SSH destination for the always-on gateway (an alias from ~/.ssh/config,
# a hostname, or user@host). Key-based auth is required.
GATEWAY_SSH_HOST="gateway"

# Broadcast address of the workstation's LAN, as seen by the gateway.
# Leave empty to use the wakeonlan default.
WOL_BROADCAST="192.168.1.255"

# Seconds to wait for the RDP port after sending Wake-on-LAN.
BOOT_TIMEOUT="120"

# Name of the credential-store entry that holds the RDP password.
#   macOS : Keychain "service" (account = RDP_USERNAME)
#   Linux : libsecret attribute "service" (attribute "account" = RDP_USERNAME)
KEYCHAIN_SERVICE="remote-workstation"

# HiDPI scaling passed to FreeRDP. FreeRDP accepts 100, 140 or 180.
# 100 (or empty) adds no scaling option. Use 180 on a Retina display.
DISPLAY_SCALE="180"

# Optional: certificate handling passed to FreeRDP as /cert:<value>.
# "tofu" = trust on first use. Verify the first fingerprint (docs/security.md).
# RDP_CERT_OPTION="tofu"

# Optional: force a specific FreeRDP executable (name on PATH).
# FREERDP_BIN=""
